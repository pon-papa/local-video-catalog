# =====================================================================
#  local-video-catalog — .gitignore
#
#  方針:
#    このアプリは One-Folder 完結型で、実行時に生成するデータは
#    すべて APP_ROOT\userdata\ 配下に置く。
#    したがって最重要の遮断は「/userdata/ の一括除外」1 行である。
#
#    それに加えて、将来の設定変更・シンボリックリンク・誤コピー・
#    手作業でのファイル配置に備えて、同種のファイルを名前でも遮断する。
#    （多重防御。1 層が破れても他の層で止める）
#
#    実動画・実画像・実音声・実文字起こし・実説明文・実台帳・実ログ・
#    個人環境の絶対パスは、いかなる経路でも Git へ登録しない。
# =====================================================================

# ---------------------------------------------------------------------
# 1. 実行時データ（最重要・userdata 配下を全遮断）
#
#    "/userdata/" ではなく "/userdata/*" と書くこと。
#    ディレクトリ自体を除外すると git がその中へ降りないため、
#    後続の "!/userdata/.gitignore" が効かなくなる。
#    userdata\.gitignore は二重防御として更に内側でも遮断する。
# ---------------------------------------------------------------------
/userdata/*
!/userdata/.gitignore

# ---------------------------------------------------------------------
# 2. 設定（実在パス・個人環境情報を含む）
# ---------------------------------------------------------------------
settings.json
settings.local.json
config/settings.local.*
config/*.local.json
*.local.json
.env
.env.*
*.secret
*.secrets
*.token
*.key
*.pem
credentials*
gui-state.json

# ---------------------------------------------------------------------
# 3. Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
.venv-*/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# ---------------------------------------------------------------------
# 4. 台帳・エクスポート・カタログ（解析対象の内容と元動画パスを含む）
# ---------------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
catalog.html
catalog.html.tmp
video_catalog.*
/catalog/
/exports/

# ---------------------------------------------------------------------
# 5. ログ・キャッシュ・作業用
# ---------------------------------------------------------------------
/logs/
/cache/
/runs/
/temp/
/tmp/
*.log
*.jsonl
*.tmp
*.bak
*.old

# ---------------------------------------------------------------------
# 6. AI モデル（サイズが大きく、そもそも同梱しない）
# ---------------------------------------------------------------------
/models/
*.bin
*.gguf
*.safetensors
*.pt
*.onnx

# ---------------------------------------------------------------------
# 7. 最終説明文（解析対象の内容と元動画のフルパスを含む）
# ---------------------------------------------------------------------
/descriptions/
VID-*.txt

# ---------------------------------------------------------------------
# 8. 文字起こし結果（会話・氏名・住所が含まれうる）
#    scope 別命名（transcript_full.json / transcript_s...ms_d...ms.json）と
#    旧固定名の両方を遮断する。
# ---------------------------------------------------------------------
transcript.json
transcript.txt
transcript_*.json
transcript_*.txt
segments.jsonl
segments_*.jsonl
chunk_*.json
chunk_*.txt
raw_engine_output*
run_manifest.json
run_manifest_*.json
*.raw.json
*.srt
*.vtt

# ---------------------------------------------------------------------
# 9. 映像解析の中間結果（生活空間・被写体に関する記述を含みうる）
# ---------------------------------------------------------------------
frame_*.analysis.json
asset_visual_summary.json
*.raw_response.json

# ---------------------------------------------------------------------
# 10. 代表静止画（顔・生活空間を含みうる）
# ---------------------------------------------------------------------
frame_*.jpg
frame_*.jpeg
frame_*.png
manifest.json
*.jpg.tmp
*.json.tmp

# ---------------------------------------------------------------------
# 11. 元動画の内容ごとの名前空間（src_<64桁hex>）配下は実データのみ
# ---------------------------------------------------------------------
src_*/

# ---------------------------------------------------------------------
# 12. メディアファイル一般
# ---------------------------------------------------------------------
*.mp4
*.m4v
*.mov
*.mts
*.m2ts
*.avi
*.mkv
*.mpg
*.mpeg
*.vob
*.webm
*.ts
*.wav
*.mp3
*.flac
*.aac
*.m4a
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.bmp
*.tiff

# ---------------------------------------------------------------------
# 13. OS / エディター
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------------
# 14. 例外: 追跡したいファイル
#    上のパターンで巻き込まれるが、コードとして必要なもの。
#    （userdata/.gitignore の再包含はセクション 1 で行っている）
# ---------------------------------------------------------------------
!config/settings.example.json
